diff --git a/lib/logger.ts b/lib/logger.ts
new file mode 100644
index 0000000..dbfd1be
--- /dev/null
+++ b/lib/logger.ts
@@ -0,0 +1,48 @@
+/**
+ * Minimal structured logger.
+ *
+ * Not a replacement for a full observability stack — just a single place
+ * that gives every log line a consistent level prefix instead of bare
+ * console.log/console.error scattered through actions, services, and
+ * routes. Swapping this for a real provider (Pino, Sentry, etc.) later
+ * only means changing this file.
+ */
+
+type LogContext = Record<string, unknown> | unknown;
+
+function emit(
+  level: "DEBUG" | "INFO" | "WARN" | "ERROR",
+  method: (...args: unknown[]) => void,
+  message: string,
+  context?: LogContext,
+) {
+  const prefix = `[${level}] ${message}`;
+  if (context !== undefined) {
+    method(prefix, context);
+  } else {
+    method(prefix);
+  }
+}
+
+export const logger = {
+  /** Dev-only diagnostic detail — silent in production. */
+  debug(message: string, context?: LogContext) {
+    if (process.env.NODE_ENV !== "development") return;
+    emit("DEBUG", console.log, message, context);
+  },
+
+  /** Normal operational events worth keeping a record of. */
+  info(message: string, context?: LogContext) {
+    emit("INFO", console.log, message, context);
+  },
+
+  /** Something unexpected but recoverable. */
+  warn(message: string, context?: LogContext) {
+    emit("WARN", console.warn, message, context);
+  },
+
+  /** A failure. Pass the caught error (or any context) as the second arg. */
+  error(message: string, error?: unknown) {
+    emit("ERROR", console.error, message, error);
+  },
+};
